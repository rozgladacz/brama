# Publiczne nazwy DNS. Nie wpisuj tokenu DuckDNS do tego repozytorium.
SZOP_DOMAIN=twoj-szop.duckdns.org
OPOS_DOMAIN=twoj-opos.duckdns.org

# Wersja obrazu bramy. Na produkcji można przypiąć pełny digest sha256.
CADDY_IMAGE=caddy:2.11.4-alpine

# Publiczne bindy produkcyjne. Skrypty dev nadpisują je na loopback 8080/8443.
BRAMA_HTTP_BIND=80
BRAMA_HTTPS_BIND=443
BRAMA_CADDYFILE=./Caddyfile

# Zewnętrzne sieci współdzielone wyłącznie przez Caddy i właściwą aplikację.
SZOP_EDGE_NETWORK=brama-szop
OPOS_EDGE_NETWORK=brama-opos

# Zewnętrzne wolumeny Caddy. Przy migracji ustaw faktyczne nazwy z serwera.
CADDY_DATA_VOLUME=szop_caddy_data
CADDY_CONFIG_VOLUME=szop_caddy_config
